{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://+:8080",
  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },
  "Jwt": {
    "Issuer": "azma",
    "Audience": "azma-clients",
    "SigningKey": "dev-only-please-change-this-key-min-32-chars-long",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Mcp": {
    "Enabled": true,
    "InternalApiBaseUrl": "http://localhost:8080/api",
    "RequireLoopback": false,
    "AllowPrivateNetwork": true,
    "HttpTimeoutSeconds": 10,
    "TokenValidationCacheSeconds": 60,
    "AuditLoggingEnabled": true,
    "AuditLogArguments": true,
    "AuditLogMaxStringLength": 500
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth":   { "ClusterId": "identity",  "Match": { "Path": "/api/auth/{**catch-all}" } },
      "identity-users":  { "ClusterId": "identity",  "Match": { "Path": "/api/users/{**catch-all}" } },
      "identity-ws":     { "ClusterId": "identity",  "Match": { "Path": "/api/workspaces/{**catch-all}" } },
      "project-member-roles": { "ClusterId": "projects",  "Match": { "Path": "/api/members/{userId}/project-roles" } },
      "identity-members":     { "ClusterId": "identity",  "Match": { "Path": "/api/members/{**catch-all}" } },
      "identity-invitations": { "ClusterId": "identity",  "Match": { "Path": "/api/invitations/{**catch-all}" } },
      "identity-admin":       { "ClusterId": "identity",  "Match": { "Path": "/api/admin/{**catch-all}" } },

      "projects":        { "ClusterId": "projects",  "Match": { "Path": "/api/projects/{**catch-all}" } },
      "milestones":      { "ClusterId": "projects",  "Match": { "Path": "/api/milestones/{**catch-all}" } },
      "suites":          { "ClusterId": "projects",  "Match": { "Path": "/api/suites/{**catch-all}" } },
      "sections":        { "ClusterId": "projects",  "Match": { "Path": "/api/sections/{**catch-all}" } },

      "testcases":       { "ClusterId": "testcases", "Match": { "Path": "/api/testcases/{**catch-all}" } },
      "custom-fields":   { "ClusterId": "testcases", "Match": { "Path": "/api/custom-fields/{**catch-all}" } },

      "runs":            { "ClusterId": "runs",      "Match": { "Path": "/api/runs/{**catch-all}" } },
      "run-schedules":   { "ClusterId": "runs",      "Match": { "Path": "/api/run-schedules/{**catch-all}" } },
      "results":         { "ClusterId": "runs",      "Match": { "Path": "/api/results/{**catch-all}" } },
      "attachments":     { "ClusterId": "runs",      "Match": { "Path": "/api/attachments/{**catch-all}" } },
      "media":           { "ClusterId": "runs",      "Match": { "Path": "/api/media/{**catch-all}" } },

      "automation":      { "ClusterId": "automation", "Match": { "Path": "/api/automation/{**catch-all}" } },

      "reporting":       { "ClusterId": "reporting", "Match": { "Path": "/api/reporting/{**catch-all}" } },
      "dashboards":      { "ClusterId": "reporting", "Match": { "Path": "/api/dashboards/{**catch-all}" } }
    },
    "Clusters": {
      "identity":  { "Destinations": { "d1": { "Address": "http://localhost:5201/" } } },
      "projects":  { "Destinations": { "d1": { "Address": "http://localhost:5202/" } } },
      "testcases": { "Destinations": { "d1": { "Address": "http://localhost:5203/" } } },
      "runs":      { "Destinations": { "d1": { "Address": "http://localhost:5204/" } } },
      "automation": { "Destinations": { "d1": { "Address": "http://localhost:5206/" } } },
      "reporting": { "Destinations": { "d1": { "Address": "http://localhost:5205/" } } }
    }
  }
}
